# ============================================================
# DramaFlow 环境变量
# 默认 OPENAI_COMPAT_MOCK_FALLBACK=false：未配置真实 AI provider key 时 API 启动会 fail-fast。
# 如需在无 key 环境下运行（产出 mock 内容用于演示/开发），改为 true。
# 必填项：DATABASE_URL、JWT_ACCESS_SECRET、JWT_REFRESH_SECRET、INTERNAL_API_KEY。
# 启用真实 AI 生成还需配置对应 provider key（见下方注释）。
# ============================================================
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
DATABASE_URL=postgresql://dramaflow:dramaflow@localhost:5432/dramaflow?schema=public
# API 测试（npm test）需要独立的测试数据库（库名需包含 test）；不跑 API 测试可不配置
# TEST_DATABASE_URL=postgresql://dramaflow:dramaflow@localhost:5432/dramaflow_test?schema=public
LEGACY_DEV_DB_PATH=
UPLOADS_DIR=./apps/api/uploads
STORAGE_DRIVER=local
LOCAL_STORAGE_PUBLIC_URL=http://localhost:4000/uploads
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=dramaflow
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
JWT_ACCESS_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me-too
INTERNAL_API_KEY=replace-me-internal

# Worker / 任务可靠性
# Worker 轮询间隔（毫秒）
WORKER_POLL_INTERVAL_MS=4000
# Worker 单次 fetch 超时（毫秒）。/next、/process、/retry 超过此值视为失败，
# /process 超时会走重试分支。设为略大于最慢 AI 任务的值，避免误杀慢任务。
WORKER_FETCH_TIMEOUT_MS=30000
# Reaper：running 任务超过多少分钟无心跳更新（updatedAt）视为滞留，自动标记 failed。
# 用于回收 worker 崩溃后无人认领的 running 任务。设为略大于最慢 provider 执行时间的保守上限。
JOB_STALE_TIMEOUT_MINUTES=15
# Reaper 执行间隔（毫秒）
JOB_REAP_INTERVAL_MS=60000
# 视频轮询任务最小间隔（秒）：避免多 worker 实例轰炸同一正在轮询的 video job
VIDEO_POLL_MIN_INTERVAL_SECONDS=10
# 是否启用 reaper 定时器（默认 true）。
# 多实例部署时只在一个实例上设 true，其余设 false，避免重复回收。
REAP_STALE_JOBS_ENABLED=true
OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1
OPENAI_COMPAT_API_KEY=replace-me
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_COMPAT_MOCK_FALLBACK=false
# TTS 走独立的 OpenAI 兼容配置；OPENAI_TTS_MODEL 留空时默认 tts-1
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_TTS_MODEL=tts-1
GOOGLE_IMAGE_API_KEY=replace-me
GOOGLE_IMAGE_MODEL=gemini-3.1-flash-image-preview
GOOGLE_IMAGE_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Example for the validated third-party OpenAI-compatible gateway:
# OPENAI_COMPAT_BASE_URL=https://new-api.ms-egde.de5.net/v1
# OPENAI_TEXT_MODEL=moonshotai/kimi-k2-instruct
# OPENAI_COMPAT_MOCK_FALLBACK=false
MEDIA_IMAGE_MODEL=gpt-image-1
MEDIA_VIDEO_MODEL=sora-2

# Stable Diffusion WebUI
SD_WEBUI_BASE_URL=http://localhost:7860
SD_WEBUI_API_KEY=

# ComfyUI
COMFYUI_BASE_URL=http://localhost:8181
COMFYUI_API_KEY=

# FFmpeg / 导出（可选）
# FFMPEG_PATH / FFPROBE_PATH 留空时从 PATH 查找 ffmpeg / ffprobe
FFMPEG_PATH=
FFPROBE_PATH=
# 导出烧录字幕视频时 drawtext 使用的字体文件路径（Windows 下建议显式指定）
FFMPEG_FONT_PATH=
# 设为 true 时保留导出临时文件（调试用）
EXPORT_KEEP_TEMP=false