# ============================================================
# DramaFlow 环境变量
# 默认 OPENAI_COMPAT_MOCK_FALLBACK=false：未配置真实 AI provider key 时 API 启动会 fail-fast。
# 如需在无 key 环境下运行（产出 mock 内容用于演示/开发），改为 true。
# 必填项：DATABASE_URL、JWT_ACCESS_SECRET、JWT_REFRESH_SECRET、INTERNAL_API_KEY。
# 启用真实 AI 生成还需配置对应 provider key（见下方注释）。
# ============================================================
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
DATABASE_URL=postgresql://dramaflow:dramaflow@localhost:5432/dramaflow?schema=public
LEGACY_DEV_DB_PATH=
UPLOADS_DIR=./apps/api/uploads
STORAGE_DRIVER=local
LOCAL_STORAGE_PUBLIC_URL=http://localhost:4000/uploads
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=dramaflow
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
JWT_ACCESS_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me-too
INTERNAL_API_KEY=replace-me-internal
OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1
OPENAI_COMPAT_API_KEY=replace-me
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_COMPAT_MOCK_FALLBACK=false
GOOGLE_IMAGE_API_KEY=replace-me
GOOGLE_IMAGE_MODEL=gemini-3.1-flash-image-preview
GOOGLE_IMAGE_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Example for the validated third-party OpenAI-compatible gateway:
# OPENAI_COMPAT_BASE_URL=https://new-api.ms-egde.de5.net/v1
# OPENAI_TEXT_MODEL=moonshotai/kimi-k2-instruct
# OPENAI_COMPAT_MOCK_FALLBACK=false
MEDIA_IMAGE_MODEL=gpt-image-1
MEDIA_VIDEO_MODEL=sora-2

# Stable Diffusion WebUI
SD_WEBUI_BASE_URL=http://localhost:7860
SD_WEBUI_API_KEY=

# ComfyUI
COMFYUI_BASE_URL=http://localhost:8188
COMFYUI_API_KEY=